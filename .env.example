# --- Formulario de contacto (servidor) ---
# Sin estas dos variables el formulario NO envía correos y avisa al visitante.
RESEND_API_KEY=
# Correo que recibe las solicitudes de contacto / cotización
CONTACT_TO=
# Remitente verificado en Resend (opcional; por defecto usa onboarding@resend.dev)
CONTACT_FROM=

# Puerto (Railway lo asigna solo)
PORT=3000
